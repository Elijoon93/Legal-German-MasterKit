{
  "version": "9.3.3",
  "release": "Runtime Freeze Elimination",
  "scope": "Stability remediation only; no new menu, learning module or content feature.",
  "confirmed_root_causes": [
    "ResizeObserver observed the root element while its callback changed root CSS variables and dataset values.",
    "MutationObserver observed the navigation subtree while its callback rewrote navigation textContent.",
    "Startup recovery could execute boot more than once when a non-dashboard route was active.",
    "Offline cache repair competed with startup by scanning and fetching active assets immediately after DOMContentLoaded.",
    "Compact rail labels were not hidden because an older #mainNav !important selector had higher specificity.",
    "Device Acceptance sampled the page before appReady, runtimeStable and adaptive shell markers were available, producing false FAIL cards.",
    "Incomplete matrix results from previous releases were displayed as current results."
  ],
  "runtime_changes": {
    "resize_observer_removed": true,
    "mutation_observer_removed": true,
    "adaptive_normalization_idempotent": true,
    "duplicate_boot_recovery_forbidden": true,
    "maximum_recovery_attempts": 1,
    "active_route_readiness_supported": true,
    "cache_repair_runs_after_ready_and_idle": true,
    "one_shot_runtime_convergence": true,
    "persistent_polling_added": false
  },
  "device_acceptance_hotfix": {
    "cache_revision": "20260728b",
    "sample_only_after_app_ready": true,
    "sample_only_after_runtime_stable": true,
    "adaptive_normalization_before_collection": true,
    "two_animation_frames_before_profile_collection": true,
    "profile_timeout_ms": 15000,
    "stale_release_results_ignored": true,
    "width_status_independent_from_global_status": true,
    "failing_check_names_visible": true,
    "active_device_page_rerendered_after_stability": true
  },
  "compact_windows": {
    "rail_width_px": 88,
    "labels_hidden_with_id_specific_selector": true,
    "rail_horizontal_overflow_forbidden": true,
    "content_column_minmax_zero": true
  },
  "preserved": {
    "dual_reference_learning_os": true,
    "physical_visual_acceptance": true,
    "adaptive_modes": ["desktop", "compact", "tablet", "phone"],
    "legal_content": true,
    "user_state": true,
    "offline_support": true
  },
  "acceptance_gates": {
    "firefox_slow_page_warning_forbidden": true,
    "resize_observer_in_adaptive_runtime_forbidden": true,
    "mutation_observer_in_visual_guard_forbidden": true,
    "runtime_stable_marker_required": true,
    "single_sidebar_required": true,
    "compact_label_clipping_forbidden": true,
    "startup_status_must_disappear": true,
    "false_fail_before_stability_forbidden": true,
    "stale_matrix_results_forbidden": true,
    "visible_runtime_badge": "v9.3.3",
    "state_reset": false
  }
}
